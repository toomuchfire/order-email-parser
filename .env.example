# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=your-key-here
# Optional: override the model
# ORDER_PARSER_MODEL=claude-haiku-5-5

# Gmail test inbox (only needed with --source gmail)
# Requires 2-step verification, then Google Account > Security > App passwords
GMAIL_ADDRESS=your-test-inbox@gmail.com
GMAIL_APP_PASSWORD=sixteen-letter-app-password

# Where draft order emails are addressed (the order desk). Use your real address in .env only.
ORDER_DESK_EMAIL=orders@example.com

# Sign-off on draft order emails. Use \n for a line break. Set your real name in .env only.
ORDER_SIGNATURE=John Smith\nWine Consultant, NYC
